#!/usr/bin/env python3

import argparse
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import shutil
import subprocess


PROJECT_ROOT = Path(__file__).resolve().parent
REPOSITORY_ROOT = PROJECT_ROOT.parents[1]
os.environ['WORKTREE_SANDBOX_PROFILE_ROOT'] = str(REPOSITORY_ROOT / 'projects')
loader = importlib.machinery.SourceFileLoader(
    'snowfamily_sandbox_runtime',
    str(REPOSITORY_ROOT / 'tools/worktree-sandbox/worktree-sandbox'),
)
spec = importlib.util.spec_from_loader(loader.name, loader)
runtime = importlib.util.module_from_spec(spec)
loader.exec_module(runtime)
REPOSITORIES = ('crm-server', 'crm-client', 'instructor', 'lesson-request')


def worktree(name, task):
    return Path.home() / '.worktree' / 'snowfamily' / name / task


def plan_for(name, task):
    root = worktree(name, task)
    if not root.is_dir():
        raise runtime.SandboxError(f'Missing worktree: {root}')
    return runtime.infer_plan(root)


def backend_port(task):
    plan = plan_for('crm-server', task)
    if not runtime.sandbox_exists(plan):
        raise runtime.SandboxError('Start the backend sandbox first')
    port = runtime.host_port(plan)
    if not port:
        raise runtime.SandboxError('The backend sandbox has no published port')
    return port


def prepare_plan(name, task):
    plan = plan_for(name, task)
    state = Path(plan['state_dir'])
    state.mkdir(parents=True, exist_ok=True)
    if name == 'crm-server':
        shutil.copy2(PROJECT_ROOT / 'seed-fixtures.cjs', state / 'seed-fixtures.cjs')
        shutil.copy2(PROJECT_ROOT / 'in-node', state / 'in-node')
        plan['commands']['migrate'].append('bash "$SANDBOX_STATE_DIR/in-node" node "$SANDBOX_STATE_DIR/seed-fixtures.cjs"')
    else:
        port = backend_port(task)
        endpoint = f'http://host.docker.internal:{port}'
        plan['env']['GRAPHQL_ENDPOINT'] = f'{endpoint}/graphql'
        if name == 'crm-client':
            (state / 'proxy.json').write_text(json.dumps({
                '/graphql': {'target': endpoint, 'secure': False, 'changeOrigin': True},
            }, indent=2) + '\n')
        runtime.create(plan)
        configure_backend_access(plan, port)
    return plan
def configure_backend_access(plan, port):
    access_file = Path(plan['state_dir']) / 'backend-access.json'
    resource = f'localhost:{port}'
    if access_file.exists():
        previous = json.loads(access_file.read_text())['resource']
        if previous != resource:
            rules = json.loads(subprocess.check_output([
                'sbx', 'policy', 'ls', plan['sandbox'], '--source', 'local',
                '--type', 'network', '--json',
            ], text=True))['rules']
            for rule in rules:
                if rule.get('scope') == f"sandbox:{plan['sandbox']}" and rule.get('resources') == [previous]:
                    subprocess.run([
                        'sbx', 'policy', 'rm', 'network', '--sandbox', plan['sandbox'],
                        '--id', rule['id'],
                    ], check=True)
    subprocess.run([
        'sbx', 'policy', 'allow', 'network', '--sandbox', plan['sandbox'], resource,
    ], check=True)
    access_file.write_text(json.dumps({'resource': resource}) + '\n')


def main():
    parser = argparse.ArgumentParser(description='Run Snowfamily with the central sandbox lifecycle')
    parser.add_argument('command', choices=('plan', 'up', 'restart', 'status', 'verify', 'stop', 'remove', 'exec'))
    parser.add_argument('--task', default='sandbox-baseline')
    parser.add_argument('--repo', choices=REPOSITORIES)
    parser.add_argument('arguments', nargs=argparse.REMAINDER)
    args = parser.parse_args()
    names = (args.repo,) if args.repo else REPOSITORIES
    if args.command in ('stop', 'remove'):
        names = tuple(reversed(names))
    for name in names:
        plan = plan_for(name, args.task)
        if args.command == 'plan':
            runtime.print_plan(plan)
        elif args.command == 'up':
            runtime.up(prepare_plan(name, args.task))
        elif args.command == 'restart':
            runtime.restart(prepare_plan(name, args.task))
        elif args.command == 'status':
            runtime.status(plan)
        elif args.command in ('stop', 'remove'):
            getattr(runtime, args.command)(plan)
        elif args.command == 'verify':
            plan = prepare_plan(name, args.task)
            runtime.ensure_running(plan)
            runtime.start_keepalive(plan)
            runtime.stop_application(plan)
            try:
                runtime.sandbox_exec(plan, ['bash', '-lc', plan['commands']['verify']])
            finally:
                runtime.restart(plan)
        else:
            if not args.repo:
                parser.error('exec requires --repo')
            command = args.arguments
            if command and command[0] == '--':
                command = command[1:]
            if not command:
                parser.error('exec requires a command after --')
            runtime.ensure_running(plan)
            runtime.start_keepalive(plan)
            return runtime.sandbox_exec(plan, command, check=False).returncode
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (runtime.SandboxError, subprocess.CalledProcessError) as error:
        print(f'Snowfamily sandbox: {error}')
        raise SystemExit(1)
