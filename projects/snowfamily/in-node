#!/usr/bin/env bash
set -euo pipefail

exec docker run --rm --init --network host \
  --user "$(id -u):$(id -g)" \
  --env-file "$SANDBOX_STATE_DIR/sandbox.env" \
  --env npm_config_cache=/tmp/npm-cache \
  --volume "$PWD:$PWD" \
  --volume "$SANDBOX_STATE_DIR:$SANDBOX_STATE_DIR" \
  --workdir "$PWD" \
  node:14.20.1-alpine "$@"
